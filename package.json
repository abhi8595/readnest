{
  "name": "readnest",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "node --test test/parsers.test.js test/reader-html.test.js test/growth.test.js test/pdf.test.js test/webdav.test.js test/sync.test.js test/tts-smart.test.js test/translate.test.js test/wordbook.test.js test/explain.test.js",
    "preflight": "node scripts/check-prod-env.js",
    "db:reset": "expo start --clear"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.2.3",
    "@expo-google-fonts/crimson-pro": "^0.2.3",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/libre-baskerville": "^0.2.3",
    "@react-navigation/native": "^7.0.0",
    "expo": "~56.0.0",
    "expo-asset": "~56.0.24",
    "expo-auth-session": "~56.0.18",
    "expo-brightness": "~56.0.5",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.25",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.27",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.17",
    "expo-router": "~56.2.20",
    "expo-screen-orientation": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.15",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.6",
    "fast-xml-parser": "^4.5.0",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.46.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "^14.2.0",
    "react-native-pdf": "^6.7.7",
    "react-native-purchases": "^8.9.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-zip-archive": "^7.0.1",
    "readnest-tts": "file:modules/readnest-tts",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~9.0.0",
    "typescript": "^5.6.0"
