# ReadNest keys — copy to .env and fill in. Never commit .env.
# All are optional at build time; missing keys degrade gracefully in-app.

# EAS project (from `eas init`)
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# RevenueCat public SDK keys (Project Settings → API keys)
EXPO_PUBLIC_RC_IOS=
EXPO_PUBLIC_RC_ANDROID=

# AdMob app IDs (Apps → App settings; also baked into the native manifest)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy

# AdMob ad units (production only; dev uses Google test units)
EXPO_PUBLIC_ADMOB_BANNER=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
EXPO_PUBLIC_ADMOB_INTERSTITIAL=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz

# Google OAuth client IDs, one Cloud project (APIs & Services → Credentials)
# Web client ID doubles as the Drive API client; Android ID must match the
# com.abhirahtech.readnest package + release SHA-1.
EXPO_PUBLIC_GOOGLE_IOS_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_ID=
EXPO_PUBLIC_GOOGLE_WEB_ID=
